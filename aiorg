#!/usr/bin/env bash
#
# aiorg — AI 조직 프레임워크 CLI
#
# 조직도를 YAML 로 선언하면 그대로 tmux 세션 조직을 세우고,
# 멤버(독립 Claude Code 세션) 사이의 지시·보고·태스크를 관리한다.
#
#   ./aiorg up                 조직 구성
#   ./aiorg status             현황판
#   ./aiorg assign dev-1 "..."  태스크 배정 + 지시 전달  (관리자용)
#   ./aiorg inbox              내 수신함 확인            (전원)
#   ./aiorg report "..."       상급자에게 보고           (실무자용)
#
set -uo pipefail

AIORG_HOME="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export AIORG_HOME
AIORG_PY="${AIORG_PY:-python3}"
export AIORG_PY
STATE="$AIORG_HOME/lib/orgstate.py"

# 기본 조직도를 고르는 순서. --org 를 붙였으면 그것이 언제나 이긴다.
#
#   1. AIORG_ORG 환경변수
#   2. org/default.yaml
#   3. 지금 떠 있는 조직 (runtime 에 기록된 것)
#   4. org/ 에 내 조직도가 딱 하나면 그것
#   5. 표준 템플릿
#
# 3, 4 가 없던 탓에 겪은 것: org/mycorp.yaml 을 만들어 놓고 `./aiorg up` 을
# --org 없이 치면 조용히 템플릿으로 떴다. 템플릿은 workdir 이 "." 이라
# 조직이 이 프레임워크 저장소에서 일하기 시작한다. 경고는 나오지만 늦다.
# 내 조직도가 하나뿐이면 그걸 쓰려던 것이 거의 확실하다.
AIORG_ORG_CANDIDATES=""
if [[ -n ${AIORG_ORG:-} ]]; then
  DEFAULT_ORG="$AIORG_ORG"
elif [[ -f "$AIORG_HOME/org/default.yaml" ]]; then
  DEFAULT_ORG="org/default.yaml"
else
  # 지금 떠 있는 조직을 따라간다. up 이후의 모든 명령이 같은 조직을 보게 된다.
  aiorg_running_org=""
  if [[ -f "$AIORG_HOME/runtime/org.resolved.json" ]]; then
    aiorg_running_org="$("$AIORG_PY" - <<'RESOLVED' 2>/dev/null || true
import json, os, pathlib
p = pathlib.Path(os.environ["AIORG_HOME"]) / "runtime" / "org.resolved.json"
try:
    src = json.loads(p.read_text(encoding="utf-8")).get("source", "")
except Exception:
    src = ""
if src and pathlib.Path(src).is_file():
    print(src)
RESOLVED
)"
  fi
  # 내가 만든 조직도 목록 (템플릿은 org/templates/ 아래라 여기 안 걸린다)
  aiorg_org_list=()
  for f in "$AIORG_HOME"/org/*.yaml; do
    [[ -f $f ]] && aiorg_org_list+=("$f")
  done
  AIORG_ORG_CANDIDATES="$(printf '%s
' "${aiorg_org_list[@]:-}")"
  if [[ -n $aiorg_running_org ]]; then
    DEFAULT_ORG="$aiorg_running_org"
  elif [[ ${#aiorg_org_list[@]} -eq 1 ]]; then
    DEFAULT_ORG="${aiorg_org_list[0]}"
  else
    DEFAULT_ORG="org/templates/product-team.yaml"
  fi
fi
export AIORG_ORG_CANDIDATES

# shellcheck source=lib/tmuxlib.sh
source "$AIORG_HOME/lib/tmuxlib.sh"

die() { printf 'aiorg: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }
st() { "$AIORG_PY" "$STATE" "$@"; }

# ---------------------------------------------------------------- 신원 확인

# 나는 누구인가. AIORG_ME 가 우선, 없으면 현재 tmux pane 으로 역추적.
aiorg_whoami() {
  if [[ -n ${AIORG_ME:-} ]]; then
    printf '%s\n' "$AIORG_ME"
    return 0
  fi
  local f
  f="$(aiorg_panes_file)"
  if [[ -n ${TMUX_PANE:-} && -f $f ]]; then
    awk -F'\t' -v want="$TMUX_PANE" '$3 == want { print $1; exit }' "$f"
  fi
}

require_me() {
  local me
  me="$(aiorg_whoami)"
  [[ -n $me ]] || die "발신자를 알 수 없습니다. AIORG_ME 환경변수를 설정하거나 --from 으로 지정하세요."
  printf '%s\n' "$me"
}

# ---------------------------------------------------------------- 전달

# 수신자에게 벨을 울린다. idle 이 아니면 보류하고 1을 반환.
deliver_bell() {
  local to="$1" pane state n
  pane="$(aiorg_pane_of "$to")"
  state="$(aiorg_member_state "$pane")"
  if [[ $state != idle ]]; then
    return 1
  fi
  n="$(st unread-count --me "$to")"
  aiorg_ring "$pane" "[aiorg] 새 메시지 ${n}건이 도착했습니다. aiorg inbox 로 확인하고 지시서에 따라 처리하세요." || return 1
  return 0
}

# 메시지 하나를 만들고 벨까지 시도. 메시지 id 를 표준출력으로.
send_one() {
  local from="$1" to="$2" type="$3" subject="$4" bodyfile="$5" task="$6" replyto="$7"
  local args=(msg-new --from "$from" --to "$to" --type "$type" --body-file "$bodyfile")
  [[ -n $subject ]] && args+=(--subject "$subject")
  [[ -n $task ]] && args+=(--task "$task")
  [[ -n $replyto ]] && args+=(--reply-to "$replyto")

  local mid
  mid="$(st "${args[@]}")" || return 1

  if deliver_bell "$to"; then
    st msg-mark --id "$mid" --state notified >/dev/null
    printf '%s\t%s\t%s\n' "$to" "$mid" "전달"
  else
    printf '%s\t%s\t%s\n' "$to" "$mid" "대기(수신자 작업중 또는 미가동 — ./aiorg notify 로 재시도)"
  fi
}

# ---------------------------------------------------------------- 서브커맨드

cmd_up() {
  local orgfile="$DEFAULT_ORG" launch=0 explicit=0
  while (($#)); do
    case "$1" in
      --org) orgfile="$2"; explicit=1; shift 2 ;;
      --launch) launch=1; shift ;;
      *) die "up: 알 수 없는 옵션 '$1'" ;;
    esac
  done

  # 내 조직도가 둘 이상인데 --org 를 안 붙였다면 고르게 한다. 조용히 템플릿으로
  # 뜨면 조직이 이 프레임워크 저장소에서 일하기 시작하고(템플릿의 workdir 은 ".")
  # 알아챌 때는 이미 파일이 쌓여 있다.
  if [[ $explicit -eq 0 && $orgfile == org/templates/* && -n ${AIORG_ORG_CANDIDATES:-} ]]; then
    local n
    n="$(grep -c . <<<"$AIORG_ORG_CANDIDATES")"
    if [[ ${n:-0} -gt 1 ]]; then
      die "org/ 에 조직도가 ${n}개 있습니다. 어느 것으로 띄울지 지정하세요.

$(while read -r f; do [[ -n $f ]] && printf '  ./aiorg up --org %s
' "$(basename "${f%.yaml}")"; done <<<"$AIORG_ORG_CANDIDATES")

  매번 붙이기 싫으면 하나를 org/default.yaml 로 두거나 AIORG_ORG 를 쓰세요."
    fi
  fi

  command -v tmux >/dev/null || die "tmux 를 찾을 수 없습니다. WSL 안에서 실행하고 있는지 확인하세요."

  st resolve "$orgfile" || exit 1

  local workdir layout
  workdir="$(aiorg_org_field workdir)"
  [[ $workdir == /* ]] || workdir="$AIORG_HOME/${workdir#./}"
  layout="$(aiorg_org_field layout)"
  [[ -n $layout ]] || layout=windows

  # 워킹트리를 쓰는 멤버가 있으면 먼저 만든다.
  # 같은 디렉터리를 공유하면 git checkout 이 서로를 짓밟기 때문이다.
  local -a wt_members=()
  mapfile -t wt_members < <(st members --json | "$AIORG_PY" -c '
import json, sys
for m in json.load(sys.stdin):
    if m.get("worktree"):
        print(m["id"])
')
  if ((${#wt_members[@]})); then
    if ! git -C "$workdir" rev-parse --git-dir >/dev/null 2>&1; then
      die "워킹트리를 쓰려면 작업 디렉터리가 git 저장소여야 합니다: $workdir
  members[].worktree 를 끄거나, 그 디렉터리에서 git init 을 하세요."
    fi
    info ""
    info "git 워킹트리 준비 중..."
    local wid wtpath
    for wid in "${wt_members[@]}"; do
      if wtpath="$(aiorg_ensure_worktree "$workdir" "$wid")"; then
        info "  $wid -> $wtpath  (브랜치 aiorg/$wid)"
      else
        die "$wid 의 워킹트리를 만들지 못했습니다. git -C '$workdir' worktree list 로 확인하세요."
      fi
    done
  fi

  # 구성원이 이 저장소에 커밋하는 것을 기계로 막는다. 지시서 문구만으로는
  # 부족하다는 것을 실제로 확인했다 (구성원이 여기에 코드를 커밋했다).
  aiorg_install_commit_guard

  # 세션을 다시 세우기 전에 이전 pane 기록을 떠 둔다. 온전히 살아 있는 부서를
  # 알아보는 데 쓰고, 그 부서의 기록은 그대로 물려준다.
  local pfile
  pfile="$(aiorg_panes_file)"
  AIORG_PANES_PREV="$pfile.prev"
  export AIORG_PANES_PREV
  if [[ -f $pfile ]]; then cp "$pfile" "$AIORG_PANES_PREV"; else : >"$AIORG_PANES_PREV"; fi
  : >"$pfile"
  info ""
  info "tmux 세션 구성 중 (배치: $layout)..."
  local dept ids sess out
  while IFS=$'\t' read -r dept ids; do
    [[ -n $dept ]] || continue
    # shellcheck disable=SC2086
    out="$(aiorg_build_session "$dept" "$workdir" "$layout" $ids)"
    if [[ $out == CONFLICT* ]]; then
      local csess cowner
      csess="$(cut -f2 <<<"$out")"
      cowner="$(cut -f3 <<<"$out")"
      die "tmux 세션 '$csess' 은 다른 저장소가 쓰고 있습니다.
  주인: $cowner
  나  : $AIORG_HOME

  이 저장소를 복사해 여러 프로젝트를 동시에 돌리는 경우입니다.
  세션 이름이 겹치면 나중에 뜬 쪽이 먼저 돌던 조직을 죽입니다.

  조직도의 org.session_prefix 를 프로젝트마다 다르게 바꾸세요:
    org:
      session_prefix: myproj      # -> myproj-exec, myproj-dev ...

  그쪽 조직을 정말 내리려면 그 저장소에서 ./aiorg down 을 실행하세요."
    fi
    if [[ $out == REUSE* ]]; then
      sess="$(cut -f2 <<<"$out")"
      # 이 부서의 pane 기록을 그대로 물려준다
      awk -F'\t' -v s="$sess" '$2 == s' "$AIORG_PANES_PREV" >>"$pfile"
      info "  $sess ← $ids  (살아 있어 그대로 씀)"
      continue
    fi
    sess="$out"
    info "  $sess ← $ids"
  done < <(st sessions)

  st event --type org.up --kv "source=$orgfile" >/dev/null

  # 알림 지킴이를 함께 띄운다. 사람이 기억해야 하는 것으로 두면 잊고,
  # 잊으면 조직이 조용히 멈춘다 (전원 '대기' 인데 미확인이 줄지 않는다).
  if aiorg_notify_running; then
    info ""
    info "알림 지킴이: 이미 돌고 있음 ($(aiorg_notify_session))"
  elif aiorg_notify_start; then
    info ""
    info "알림 지킴이 기동 ($(aiorg_notify_session)) — 보류된 벨을 계속 재시도합니다"
  else
    info ""
    info "경고: 알림 지킴이를 띄우지 못했습니다. 별도 터미널에서 ./aiorg notify --watch 를 켜세요."
  fi

  info ""
  if ((launch)); then
    cmd_launch
  else
    info "다음 순서:"
    info "  ./aiorg launch          각 자리에서 claude 기동"
    info "  ./aiorg status          전원이 '대기' 가 될 때까지 확인"
    info "  ./aiorg brief           각자에게 역할·지시서 안내"
    info "  ./aiorg attach $(aiorg_root_member)    대표 화면에 붙어 목표를 지시"
  fi
}

# 최상위 멤버 id (사용자가 대화할 상대).
aiorg_root_member() {
  "$AIORG_PY" - <<'PY'
import json, os
p = os.path.join(os.environ["AIORG_HOME"], "runtime", "org.resolved.json")
try:
    with open(p, encoding="utf-8") as f:
        print(json.load(f)["roots"][0])
except Exception:
    print("ceo")
PY
}

cmd_launch() {
  # 구성원의 작업 디렉터리가 이 저장소 밖이면(기존 제품에 붙인 경우, 워킹트리)
  # 역할 지시서(org/roles/*.md)가 작업 디렉터리 밖이 된다. 그러면 brief 를 받자마자
  # "작업 디렉터리 밖 읽기를 허용하시겠습니까?" 대화상자가 떠서 조직 전체가 멈춘다.
  # --add-dir 로 이 저장소를 읽을 수 있는 곳에 넣어 준다.
  local cmdline="${AIORG_CLAUDE_CMD:-claude --add-dir \"$AIORG_HOME\"}"
  # 소스가 작업 디렉터리 밖에 있는 배치에서는 코드가 있는 곳도 열어 줘야 한다.
  # 안 그러면 팀장·리뷰어가 코드를 한 줄도 못 읽고, 겉으로는 대화상자가 떠서
  # 멈춘 것으로만 보인다. AIORG_CLAUDE_CMD 로 직접 지정했으면 손대지 않는다.
  #
  # --add-dir 은 작업 디렉터리를 더하는 것이므로 쓰기까지 열린다. 영역 경계는
  # 도구가 아니라 areas 와 지시서가 지킨다 — 여기서 막을 수 있는 것이 아니다.
  local add_areas=1
  [[ -n ${AIORG_CLAUDE_CMD:-} ]] && add_areas=0
  local id sess pane state count=0 running=""
  [[ -f "$(aiorg_panes_file)" ]] || die "먼저 ./aiorg up 을 실행하세요."
  info "claude 기동 중 (명령: $cmdline)..."
  while IFS=$'\t' read -r id sess pane; do
    [[ -n $id ]] || continue
    if ! aiorg_pane_alive "$pane"; then
      info "  $id — pane 없음, 건너뜀"
      continue
    fi
    # 이미 claude 가 돌고 있는 자리에 명령줄을 타이핑하면 그것이 그 구성원에게
    # 보내는 메시지가 된다. 죽은 자리 하나를 살리려고 launch 를 다시 실행했을 때
    # 나머지 전원의 대화가 오염되는 것이다. 셸 상태(down)인 자리만 띄운다.
    state="$(aiorg_member_state "$pane")"
    if [[ $state != down ]]; then
      running+=" $id"
      continue
    fi
    local cmd="$cmdline" extra
    if ((add_areas)); then
      while read -r extra; do
        [[ -n $extra ]] && cmd+=" --add-dir \"$extra\""
      done < <(st adddirs --member "$id" 2>/dev/null)
    fi
    tmux send-keys -t "$pane" -l "$cmd"
    tmux send-keys -t "$pane" Enter
    # 자리별로 기록한다. brief 를 했는지 판정하는 기준선이다 — 같은 pane 에서
    # claude 를 다시 띄우면 대화 맥락이 사라지므로 그 전의 brief 는 무효다.
    st event --type member.launch --kv "member=$id" --kv "pane=$pane" >/dev/null
    info "  $id 기동"
    count=$((count + 1))
  done <"$(aiorg_panes_file)"
  st event --type org.launch --kv "members=$count" >/dev/null
  info ""
  if [[ -n $running ]]; then
    info "이미 떠 있어 건너뜀:$running"
  fi
  if [[ $count -eq 0 ]]; then
    info "새로 띄운 자리가 없습니다. ./aiorg status 로 상태를 확인하세요."
  else
    info "$count 명 기동. 첫 실행이라면 각 pane 에서 인증을 마쳐야 합니다."
    info ""
    info "다음은 ./aiorg brief 입니다 — 빼먹으면 안 됩니다."
    info "  지금 이 자리들은 자기가 조직의 일원인 줄 모릅니다. 대표에게 목표를"
    info "  줘도 혼자 다 만들려 듭니다. brief 가 각자에게 자기 역할을 알려줍니다."
  fi
}

# 각 멤버에게 "너는 누구고 지시서를 읽어라" 는 최초 지시를 넣는다.
cmd_brief() {
  local id sess pane state title role instr sent=0 skipped=""
  [[ -f "$(aiorg_panes_file)" ]] || die "먼저 ./aiorg up 을 실행하세요."
  # 인자를 주면 그 멤버만. 죽었던 자리 하나를 되살렸을 때, 일하고 있는
  # 나머지에게 다시 지시서를 들이밀지 않기 위해서다.
  local only=" $* "
  [[ -n $* ]] && info "대상: $*"
  while IFS=$'\t' read -r id sess pane; do
    [[ -n $id ]] || continue
    if [[ $only != "  " && $only != *" $id "* ]]; then
      continue
    fi
    state="$(aiorg_member_state "$pane")"
    if [[ $state != idle ]]; then
      skipped+=" $id($state)"
      continue
    fi
    title="$(aiorg_member_field "$id" title)"
    role="$(aiorg_member_field "$id" role)"
    instr="$(aiorg_member_field "$id" instruction)"
    # 이 역할이 쓰기로 되어 있는 Claude Code 스킬을 함께 알려준다.
    # 안 알려주면 스킬이 있어도 쓰지 않는다.
    local useskills msg open_n mwd
    useskills="$(aiorg_member_field "$id" use_skills)"
    # 지시서는 프레임워크 저장소에만 있다. 상대경로로 알려주면 작업 디렉터리에서
    # 찾지 못해 프레임워크 저장소를 뒤지다가 거기를 자기 프로젝트로 착각하고
    # 산출물까지 그쪽에 만든다 (실제로 겪었다). 절대경로로 짚고, 그 저장소가
    # 읽기 전용이라는 것과 자기 작업 디렉터리가 어디인지를 함께 못 박는다.
    mwd="$(aiorg_member_field "$id" workdir_resolved)"
    [[ -n $mwd ]] || mwd="$AIORG_HOME"
    msg="당신은 이 조직의 '$id' ($title / 역할 $role) 입니다."
    msg+=" 당신의 작업 디렉터리는 $mwd 입니다 — 코드·문서·커밋은 전부 여기에만 합니다."
    msg+=" 먼저 $AIORG_HOME/org/roles/_protocol.md 와 $AIORG_HOME/$instr 를 읽고 규칙을 숙지하세요."
    msg+=" 그 두 파일이 있는 $AIORG_HOME 은 프레임워크 저장소이고 읽기 전용 참고 자료입니다 — 거기에는 아무것도 만들거나 고치지 않습니다."
    msg+=" 그다음 aiorg inbox 로 수신함을 확인하세요."
    if [[ -n $useskills ]]; then
      msg+=" 이 역할은 다음 스킬을 씁니다: ${useskills// /, }. 해당하는 일을 할 때 그 스킬을 먼저 부르세요. 목록에 없으면 없다고 보고하세요."
    fi
    # 하던 일이 있으면 알려준다. 조직을 다시 올린 경우(재부팅 포함) 구성원은
    # 자기가 무엇을 하던 중이었는지 기억하지 못한다 — 대화 맥락이 사라졌기 때문이다.
    # 태스크와 진행 기록은 파일로 남아 있으니, 그것부터 읽으라고 짚어준다.
    open_n="$(st task-list --assignee "$id" --open-only --ids 2>/dev/null | grep -c .)"
    if [[ ${open_n:-0} -gt 0 ]]; then
      msg+=" 그리고 당신에게는 이미 진행 중이던 태스크가 ${open_n}건 있습니다. aiorg task list --mine --open 으로 확인하고, aiorg task show <id> 의 이력에서 어디까지 했는지 읽은 뒤 이어서 하세요. 처음부터 다시 하지 마세요."
    fi
    aiorg_ring "$pane" "$msg"
    st event --type member.brief --kv "member=$id" --kv "pane=$pane" >/dev/null
    info "  $id 지시서 안내 전달"
    sent=$((sent + 1))
  done <"$(aiorg_panes_file)"
  info ""
  info "$sent 명에게 전달."
  if [[ -n $skipped ]]; then
    info "건너뜀:$skipped"
    info "  prompt = 대화상자가 떠 있습니다. ./aiorg attach <멤버> 로 붙어서 직접 답하세요."
    info "  starting/down = 부팅을 기다렸다가 ./aiorg brief 를 다시 실행하세요."
  else
    if [[ $only == "  " ]]; then
      info "이제 대표에게 목표를 지시하세요:  ./aiorg attach $(aiorg_root_member)"
    fi
  fi
}

cmd_down() {
  local dept
  while IFS=$'\t' read -r dept _; do
    [[ -n $dept ]] || continue
    local sess
    sess="$(aiorg_session_name "$dept")"
    if tmux kill-session -t "$sess" 2>/dev/null; then
      info "$sess 종료"
    fi
  done < <(st sessions 2>/dev/null)
  if aiorg_notify_stop; then
    info "$(aiorg_notify_session) 종료 (알림 지킴이)"
  fi
  : >"$(aiorg_panes_file)" 2>/dev/null || true
  st event --type org.down >/dev/null 2>&1 || true
  info "조직 세션을 내렸습니다. 메시지·태스크 기록은 runtime/ 에 남아 있습니다."
  if [[ -d "$(aiorg_worktree_root)" ]] && compgen -G "$(aiorg_worktree_root)/*" >/dev/null; then
    info ""
    info "git 워킹트리는 그대로 둡니다 (커밋 안 한 작업이 있을 수 있습니다):"
    info "  $(aiorg_worktree_root)/"
    info "정리하려면 각 브랜치를 병합·확인한 뒤:"
    info "  git -C <제품저장소> worktree remove <경로>   (또는 worktree prune)"
  fi
}

# 스킬이 어디 있고 구성원이 볼 수 있는지 보여준다. --link 로 연결한다.
#
# 스킬은 프레임워크 자재다 — 제품 산출물이 아니므로 이 저장소에 둔다.
# 그런데 Claude Code 는 세션이 시작한 프로젝트에서 스킬을 찾으므로,
# workdir 이 제품 저장소면(권장 설정) 여기 있는 스킬이 안 보인다.
#
# 사본을 제품 저장소마다 뿌리면 낡는다. 그래서 심링크로 사용자 레벨
# (~/.claude/skills/)에 걸어 둔다 — 어디서든 보이고, 원본을 고치면 바로 반영된다.
cmd_skills() {
  local mode=show
  while (($#)); do
    case "$1" in
      --link) mode=link; shift ;;
      --unlink) mode=unlink; shift ;;
      *) die "skills: 알 수 없는 옵션 '$1'" ;;
    esac
  done

  local src="$AIORG_HOME/.claude/skills"
  local dst="$HOME/.claude/skills"
  [[ -d $src ]] || die "이 저장소에 .claude/skills/ 가 없습니다."

  local -a names=()
  local d
  for d in "$src"/*/; do
    [[ -f "$d/SKILL.md" ]] && names+=("$(basename "$d")")
  done
  ((${#names[@]})) || die "스킬이 없습니다 ($src)."

  case "$mode" in
    show)
      info "프레임워크 스킬 (원본: .claude/skills/)"
      info ""
      local n linked
      for n in "${names[@]}"; do
        if [[ -L "$dst/$n" ]]; then
          linked="연결됨 -> $(readlink "$dst/$n")"
        elif [[ -e "$dst/$n" ]]; then
          linked="사용자 레벨에 별도로 있음 (링크 아님)"
        else
          linked="연결 안 됨"
        fi
        printf '  %-28s %s
' "$n" "$linked"
      done
      info ""
      info "연결하지 않으면 이 저장소 안에서만 보입니다. 제품 저장소를 workdir 로"
      info "쓰는 경우(권장) 구성원에게는 안 보이고, up 이 그때 경고합니다."
      info ""
      info "연결: ./aiorg skills --link      해제: ./aiorg skills --unlink"
      info "심링크이므로 사본이 아닙니다 — 원본을 고치면 바로 반영됩니다."
      ;;
    link)
      mkdir -p "$dst"
      local n done_n=0
      for n in "${names[@]}"; do
        if [[ -L "$dst/$n" ]]; then
          info "  이미 연결됨  $n"
        elif [[ -e "$dst/$n" ]]; then
          info "  건너뜀       $n  (사용자 레벨에 별도로 있습니다. 덮지 않습니다)"
        else
          ln -s "$src/$n" "$dst/$n" && info "  연결          $n" && done_n=$((done_n + 1))
        fi
      done
      info ""
      info "$done_n 개 연결. 이제 작업 디렉터리가 어디든 구성원이 이 스킬을 씁니다."
      ;;
    unlink)
      local n gone=0
      for n in "${names[@]}"; do
        if [[ -L "$dst/$n" ]]; then
          rm -f "$dst/$n" && info "  해제          $n" && gone=$((gone + 1))
        fi
      done
      info ""
      info "$gone 개 해제. 원본은 그대로 있습니다 (.claude/skills/)."
      ;;
  esac
}

# 제품 저장소에 산출물 구조를 깔아준다.
#
# 이 저장소는 프레임워크다. 산출물이 놓일 자리는 제품 저장소 것이므로 여기에
# 빈 디렉터리를 들고 있지 않는다. 대신 필요할 때 workdir 에 만들어 준다.
cmd_scaffold() {
  local workdir
  workdir="$(aiorg_org_field workdir)"
  [[ -n $workdir ]] || die "먼저 ./aiorg up 을 실행하세요 (조직도를 읽어야 workdir 을 압니다)."
  [[ $workdir == /* ]] || workdir="$AIORG_HOME/${workdir#./}"
  [[ -d $workdir ]] || die "작업 디렉터리가 없습니다: $workdir"
  # workdir: "." 이면 "$AIORG_HOME/." 이 되어 문자열 비교로는 안 걸린다.
  # 경로를 정규화해서 비교한다.
  workdir="$(cd -- "$workdir" && pwd)"

  if [[ $workdir == "$AIORG_HOME" ]]; then
    die "작업 디렉터리가 이 프레임워크 저장소입니다.
  산출물 자리는 제품 저장소에 만드는 것입니다. 조직도의 org.workdir 을 먼저 바꾸세요."
  fi

  info "산출물 구조를 만듭니다: $workdir"
  local made=0 d
  # 역할 지시서가 쓰는 자리 + 조직도의 artifacts 자리
  local -a dirs=(docs/voc/raw docs/voc/digest docs/product/specs docs/product/research docs/finops/raw docs/finops/analysis)
  while IFS= read -r d; do
    [[ -n $d ]] && dirs+=("${d%/}")
  done < <(st artifacts --json 2>/dev/null | "$AIORG_PY" -c '
import json, sys
try:
    for a in json.load(sys.stdin).values():
        print(a["path"])
except Exception:
    pass
')

  for d in "${dirs[@]}"; do
    if [[ ! -d "$workdir/$d" ]]; then
      mkdir -p "$workdir/$d" && info "  만듦   $d/" && made=$((made + 1))
    else
      info "  있음   $d/"
    fi
  done

  # VOC 안내는 사람이 읽어야 하는 것이므로 제품 저장소에 복사해 둔다.
  if [[ ! -f "$workdir/docs/voc/README.md" ]]; then
    cp "$AIORG_HOME/docs/voc/README.md" "$workdir/docs/voc/README.md" 2>/dev/null &&
      info "  만듦   docs/voc/README.md  (고객 발언 원문을 넣는 법)"
  fi
  # 비용 자료도 같다. 사람이 넣지 않으면 PO 가 숫자를 지어내게 된다.
  if [[ ! -f "$workdir/docs/finops/README.md" ]]; then
    cp "$AIORG_HOME/docs/finops/README.md" "$workdir/docs/finops/README.md" 2>/dev/null &&
      info "  만듦   docs/finops/README.md  (청구·사용 자료를 넣는 법)"
  fi
  if [[ ! -f "$workdir/docs/voc/routed.md" ]]; then
    printf '%s
' "# VOC 전달 대장" ""       "프리세일즈가 관리한다. 같은 VOC 를 두 번 전달하지 않기 위한 기록이다." ""       "| 날짜 | VOC | 출처(raw) | 전달처 | 결과 |" "|---|---|---|---|---|"       >"$workdir/docs/voc/routed.md" && info "  만듦   docs/voc/routed.md"
  fi

  info ""
  if ((made)); then
    info "제품 저장소에 자리를 만들었습니다.
  고객 발언 원문 -> docs/voc/raw/      청구·사용 자료 -> docs/finops/raw/
  둘 다 사람만 넣습니다. 비어 있으면 구성원은 \"자료가 없습니다\" 라고 보고합니다."
  else
    info "이미 다 있습니다."
  fi
}

# runtime/ 을 정리한다. 손으로 rm -rf 하게 두면 사고가 나기 때문에 명령으로 감싼다.
cmd_clean() {
  local force=0
  while (($#)); do
    case "$1" in
      --force|-f) force=1; shift ;;
      *) die "clean: 알 수 없는 옵션 '$1'" ;;
    esac
  done

  local rt="$AIORG_HOME/runtime"
  if [[ ! -d $rt ]]; then
    info "runtime/ 이 없습니다. 정리할 것이 없습니다."
    return 0
  fi

  # 세션이 살아 있으면 거부한다. 도는 조직의 발밑을 빼는 셈이다.
  local alive=0 dept
  while IFS=$'	' read -r dept _; do
    [[ -n $dept ]] || continue
    tmux has-session -t "$(aiorg_session_name "$dept")" 2>/dev/null && alive=1
  done < <(st sessions 2>/dev/null)
  if ((alive)); then
    die "조직이 아직 돌고 있습니다. ./aiorg down 을 먼저 실행하세요."
  fi

  # 무엇을 잃는지 먼저 보여준다.
  local ntask nmsg
  ntask="$(find "$rt/tasks" -name '*.json' 2>/dev/null | wc -l)"
  nmsg="$(find "$rt/inbox" -name '*.json' 2>/dev/null | wc -l)"
  info "지워질 것:"
  info "  태스크      ${ntask}건 (진행 중이던 것 포함)"
  info "  메시지      ${nmsg}건"
  info "  이벤트 로그 $(wc -l <"$rt/events.jsonl" 2>/dev/null || echo 0)줄"
  info ""
  info "남는 것:"
  info "  docs/ 의 산출물 — 요구사항 정의서, 설계, 조사 결과 등"
  info "  worktrees/ 의 코드와 브랜치 — 커밋 안 된 작업까지"

  # 커밋 안 된 작업이 있으면 반드시 알린다. 지금 지우는 것과 직접 상관은 없지만,
  # 이 시점에 조직을 정리하려는 사람은 그것도 정리할 생각일 가능성이 높다.
  local wt dirty=""
  for wt in "$(aiorg_worktree_root)"/*/; do
    [[ -d $wt ]] || continue
    if [[ -n "$(git -C "$wt" status --porcelain 2>/dev/null)" ]]; then
      dirty+=" $(basename "$wt")"
    fi
  done
  if [[ -n $dirty ]]; then
    info ""
    info "주의 — 커밋 안 된 작업이 남은 워킹트리:$dirty"
    info "  worktrees/ 는 이 명령이 건드리지 않습니다. 다만 그쪽을 정리하실 거라면"
    info "  먼저 커밋하거나 내용을 확인하세요. 지우면 되돌릴 수 없습니다."
  fi

  if ((!force)); then
    info ""
    info "실제로 지우려면 --force 를 붙이세요:  ./aiorg clean --force"
    return 0
  fi

  rm -rf "$rt"
  info ""
  info "runtime/ 을 지웠습니다. 다음 ./aiorg up 은 빈 상태에서 시작합니다."
}

cmd_status() {
  local live=""
  if [[ -f "$(aiorg_panes_file)" && -s "$(aiorg_panes_file)" ]]; then
    live="$(aiorg_write_live)"
  fi
  if [[ -n $live ]]; then
    st status --live "$live" "$@"
  else
    st status "$@"
  fi
  # brief 를 빼먹으면 구성원이 자기가 조직의 일원인 줄 모른다. 대표조차 혼자
  # 다 만들려 든다. 그런데 겉으로는 전원 '대기' 로 보여서 알아챌 수가 없다.
  if [[ -n $live ]]; then
    local unbriefed
    unbriefed="$(st unbriefed --panes "$(aiorg_panes_file)" 2>/dev/null | tr '
' ' ')"
    unbriefed="${unbriefed% }"
    if [[ -n $unbriefed ]]; then
      info ""
      info "경고: 지시서 안내를 못 받은 멤버가 있습니다: $unbriefed"
      info "      자기가 누구인지, 무엇을 해야 하는지 모르는 상태입니다."
      info "      ./aiorg brief $unbriefed"
    fi
  fi
  # 지킴이가 죽어 있으면 보류된 벨이 영원히 안 간다. 상태를 볼 때 알려준다.
  if [[ -n $live ]] && ! aiorg_notify_running; then
    info ""
    info "경고: 알림 지킴이가 돌고 있지 않습니다. 보류된 벨이 전달되지 않습니다."
    info "      ./aiorg notify        지금 한 번 재시도"
    info "      ./aiorg up            지킴이까지 다시 띄움 (살아 있는 세션은 그대로)"
  fi
}

cmd_send() {
  local from="" type="info" subject="" task="" replyto="" selector="" bodyfile=""
  local -a words=()
  while (($#)); do
    case "$1" in
      --from) from="$2"; shift 2 ;;
      --type|-t) type="$2"; shift 2 ;;
      --subject|-s) subject="$2"; shift 2 ;;
      --task) task="$2"; shift 2 ;;
      --reply-to) replyto="$2"; shift 2 ;;
      --file|-f) bodyfile="$2"; shift 2 ;;
      --) shift; words+=("$@"); break ;;
      -) words+=("$1"); shift ;;   # 홀로 쓰인 '-' 는 "본문은 표준입력" 표시
      -*) die "send: 알 수 없는 옵션 '$1'" ;;
      *) if [[ -z $selector ]]; then selector="$1"; else words+=("$1"); fi; shift ;;
    esac
  done

  [[ -n $selector ]] || die "받는 사람을 지정하세요.  예: ./aiorg send dev-1 \"작업 시작하세요\""
  [[ -n $from ]] || from="$(require_me)" || exit 1

  # RETURN 트랩은 쓰지 않는다. 트랩이 등록된 채로 남아 호출한 함수가 반환할 때
  # 한 번 더 발동하고, 그때는 $tmp 가 이미 스코프 밖이라 set -u 에 걸린다.
  local tmp
  tmp="$(mktemp)"
  if [[ -n $bodyfile ]]; then
    if [[ ! -f $bodyfile ]]; then rm -f "$tmp"; die "본문 파일이 없습니다: $bodyfile"; fi
    cat "$bodyfile" >"$tmp"
  elif ((${#words[@]} == 0)) || [[ ${words[0]:-} == - ]]; then
    cat >"$tmp"        # 표준입력에서 여러 줄 본문
  else
    printf '%s\n' "${words[*]}" >"$tmp"
  fi

  # 프로세스 치환은 종료코드를 물어오지 않는다. expand 가 실패하면 목록이
  # 비어서 돌아오므로, 그걸로 판단한다. 실패 이유는 expand 가 이미 stderr 에
  # 적어놨으니 여기서 또 떠들지 않는다.
  local -a targets=()
  mapfile -t targets < <(st expand "$selector" --me "$from" --exclude-me)
  if ((${#targets[@]} == 0)); then
    rm -f "$tmp"; exit 1
  fi

  local to
  for to in "${targets[@]}"; do
    send_one "$from" "$to" "$type" "$subject" "$tmp" "$task" "$replyto"
  done
  rm -f "$tmp"
}

cmd_reply() {
  local mid="${1:-}"; shift || true
  [[ -n $mid ]] || die "답신할 메시지 id 를 지정하세요.  예: ./aiorg reply msg_ab12cd34 \"확인했습니다\""
  local orig
  orig="$(st inbox --me "$(require_me)" --all --peek --json | "$AIORG_PY" -c '
import json, sys
mid = sys.argv[1]
for m in json.load(sys.stdin):
    if m["id"] == mid:
        print(m["from"]); break
else:
    print("")
' "$mid")"
  [[ -n $orig ]] || die "내 수신함에서 '$mid' 를 찾을 수 없습니다."
  cmd_send "$orig" --type answer --reply-to "$mid" "$@"
}

# 관리자용: 태스크를 만들고 지시까지 한 번에.
cmd_assign() {
  local to="" title="" detail="" parent="" branch=""
  while (($#)); do
    case "$1" in
      --detail|-d) detail="$2"; shift 2 ;;
      --parent|-p) parent="$2"; shift 2 ;;
      --branch|-b) branch="$2"; shift 2 ;;
      -*) die "assign: 알 수 없는 옵션 '$1'" ;;
      *) if [[ -z $to ]]; then to="$1"; elif [[ -z $title ]]; then title="$1"; else title="$title $1"; fi; shift ;;
    esac
  done
  [[ -n $to && -n $title ]] || die "사용법: ./aiorg assign <담당자> \"<제목>\" [--detail \"상세\"] [--parent <상위태스크>]"

  local me
  me="$(require_me)" || exit 1

  # 조직도의 can_assign 을 실제로 강제한다. 지시서에 "제안만 한다" 고 적어두는
  # 것만으로는 부족하다 — 규칙은 지켜질 수도 안 지켜질 수도 있지만, 여기서
  # 막으면 못 한다. PO 처럼 지휘권 없는 역할이 이 경로로 새는 것을 끊는다.
  if [[ "$(aiorg_member_field "$me" can_assign)" != "True" ]]; then
    local myrole
    myrole="$(aiorg_member_field "$me" role)"
    die "$me ($myrole) 에게는 배정 권한이 없습니다.
  이 역할은 남에게 일을 시킬 수 없습니다. 필요한 일은 상급자에게 올리세요:
    ./aiorg report \"$title\"
  조직도에서 권한을 주려면 roles.$myrole.can_assign 을 true 로 바꿉니다."
  fi

  local -a targets=()
  mapfile -t targets < <(st expand "$to" --me "$me" --exclude-me) || exit 1

  local one tid tmp
  for one in "${targets[@]}"; do
    local -a targs=(task-new --title "$title" --assigner "$me" --assignee "$one")
    [[ -n $detail ]] && targs+=(--detail "$detail")
    [[ -n $parent ]] && targs+=(--parent "$parent")
    [[ -n $branch ]] && targs+=(--branch "$branch")
    tid="$(st "${targs[@]}")" || exit 1

    tmp="$(mktemp)"
    {
      printf '태스크 %s 를 배정합니다.\n\n' "$tid"
      printf '제목: %s\n' "$title"
      [[ -n $detail ]] && printf '\n상세:\n%s\n' "$detail"
      [[ -n $branch ]] && printf '\n작업 브랜치: %s\n' "$branch"
      printf '\n착수할 때  : ./aiorg task start %s\n' "$tid"
      printf '완료했을 때: ./aiorg task done %s --note "무엇을 했는지"\n' "$tid"
      printf '막혔을 때  : ./aiorg task block %s --note "무엇에 막혔는지"\n' "$tid"
      printf '보고할 때  : ./aiorg report --task %s "결과 요약"\n' "$tid"
    } >"$tmp"

    send_one "$me" "$one" "directive" "[배정] $title" "$tmp" "$tid" ""
    rm -f "$tmp"
    printf '  태스크 %s → %s\n' "$tid" "$one"
  done
}

# 실무자용: 상급자에게 보고.
cmd_report() {
  local task="" subject=""
  local -a words=()
  while (($#)); do
    case "$1" in
      --task) task="$2"; shift 2 ;;
      --subject|-s) subject="$2"; shift 2 ;;
      -) words+=("$1"); shift ;;   # 홀로 쓰인 '-' 는 "본문은 표준입력" 표시
      -*) die "report: 알 수 없는 옵션 '$1'" ;;
      *) words+=("$1"); shift ;;
    esac
  done
  local me
  me="$(require_me)" || exit 1
  # 최상위 멤버는 상급자가 없다. expand 의 기계적인 오류 대신 사정을 설명한다.
  local boss
  boss="$(st expand @boss --me "$me" 2>/dev/null)" || true
  [[ -n $boss ]] || die "$me 에게는 상급자가 없습니다. 보고 대신 ./aiorg send <상대> 로 직접 보내세요."

  local -a args=("$boss" --from "$me" --type report)
  [[ -n $task ]] && args+=(--task "$task")
  [[ -n $subject ]] && args+=(--subject "$subject")
  cmd_send "${args[@]}" -- "${words[@]}"
}

cmd_inbox() {
  local me
  me="$(require_me)" || exit 1
  st inbox --me "$me" "$@"
}

cmd_task() {
  local sub="${1:-list}"; shift || true
  local me
  me="$(aiorg_whoami)"
  case "$sub" in
    new)
      local -a args=(task-new)
      [[ -n $me ]] && args+=(--assigner "$me")
      st "${args[@]}" "$@"
      ;;
    start)   task_transition in_progress "$me" "$@" ;;
    done)    task_transition done "$me" "$@" ;;
    block)   task_transition blocked "$me" "$@" ;;
    review)  task_transition review "$me" "$@" ;;
    cancel)  task_transition cancelled "$me" "$@" ;;
    set)     st task-set --by "${me:-unknown}" "$@" ;;
    show)
      local tid="${1:-}"; shift || true
      [[ -n $tid ]] || die "태스크 id 를 지정하세요."
      st task-show --id "$tid" "$@"
      ;;
    tree)    st task-tree ;;
    list|"")
      local -a args=(task-list)
      while (($#)); do
        case "$1" in
          --mine) [[ -n $me ]] && args+=(--assignee "$me"); shift ;;
          --open) args+=(--open-only); shift ;;
          *) args+=("$1"); shift ;;
        esac
      done
      st "${args[@]}"
      ;;
    *) die "task: 알 수 없는 하위 명령 '$sub' (new|start|done|block|review|cancel|set|show|list|tree)" ;;
  esac
}

task_transition() {
  local status="$1" by="$2"; shift 2
  local tid="${1:-}"; shift || true
  [[ -n $tid ]] || die "태스크 id 를 지정하세요.  예: ./aiorg task $status t_ab12cd34"
  st task-set --id "$tid" --status "$status" --by "${by:-unknown}" "$@"
}

# 보류된 벨을 재시도. --watch 면 계속 돈다.
cmd_notify() {
  local watch=0 interval=20
  while (($#)); do
    case "$1" in
      --watch|-w) watch=1; shift ;;
      --interval) interval="$2"; shift 2 ;;
      *) die "notify: 알 수 없는 옵션 '$1'" ;;
    esac
  done

  while :; do
    local to n delivered=0 held=0
    while IFS=$'\t' read -r to n; do
      [[ -n $to ]] || continue
      if deliver_bell "$to"; then
        # 이 수신자의 queued 메시지 전부를 notified 로 넘긴다 (벨 한 번에 다 알림).
        st inbox --me "$to" --peek --json | "$AIORG_PY" -c '
import json, sys
for m in json.load(sys.stdin):
    if m.get("state") == "queued":
        print(m["id"])
' | while read -r mid; do
          [[ -n $mid ]] && st msg-mark --id "$mid" --state notified >/dev/null
        done
        printf '%s: %s건 알림 전달\n' "$to" "$n"
        delivered=$((delivered + 1))
      else
        printf '%s: %s건 보류 (작업중/미가동)\n' "$to" "$n"
        held=$((held + 1))
      fi
    done < <(st pending)

    if ((delivered == 0 && held == 0)); then
      ((watch)) || info "보류된 알림이 없습니다."
    fi
    ((watch)) || break
    sleep "$interval"
  done
}

cmd_org() { cmd_status "$@"; }
# tmux 배치를 한 표로. 조직도와 tmux 를 눈으로 맞춰 보던 것을 모은 것이다.
cmd_layout() {
  [[ -f "$(aiorg_panes_file)" ]] || die "먼저 ./aiorg up 을 실행하세요."
  local rows id sess pane state widx wname
  rows="$AIORG_HOME/runtime/layout.tsv"
  : >"$rows"
  while IFS=$'\t' read -r id sess pane; do
    [[ -n $id ]] || continue
    if ! aiorg_pane_alive "$pane"; then
      printf '%s\t%s\t-\t-\t-\tdown\n' "$id" "$sess" >>"$rows"
      continue
    fi
    # display-message 는 서식 문자열 안의 백슬래시-t 를 탭으로 바꾸지 않고
    # 그대로 찍는다. 창 이름은 멤버 id 라 공백이 없으므로 공백으로 나눈다.
    read -r widx wname < <(tmux display-message -p -t "$pane" '#{window_index} #{window_name}' 2>/dev/null)
    state="$(aiorg_member_state "$pane")"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$sess" "${widx:--}" "${wname:--}" "$pane" "$state" >>"$rows"
  done <"$(aiorg_panes_file)"

  local nstate
  if aiorg_notify_running; then
    nstate="$(aiorg_notify_session) — 가동중"
  else
    nstate="꺼져 있음  <-- 보류된 벨이 전달되지 않습니다. ./aiorg up"
  fi
  st layout --rows "$rows" --notify "$nstate" --layout "$(aiorg_org_field layout)"
}

# 붙지 않고 그 자리 화면만 본다. attach 와 달리 아무것도 입력되지 않으므로
# 작업 중인 멤버를 방해할 위험이 없다.
cmd_peek() {
  local who="" lines=30
  while (($#)); do
    case "$1" in
      --lines|-n) lines="$2"; shift 2 ;;
      -*) die "peek: 알 수 없는 옵션 '$1'" ;;
      *) who="$1"; shift ;;
    esac
  done
  [[ -n $who ]] || die "누구를 볼지 지정하세요: ./aiorg peek <멤버>"
  local pane
  pane="$(aiorg_pane_of "$who")"
  [[ -n $pane ]] || die "'$who' 의 자리를 찾을 수 없습니다. ./aiorg members --ids 로 확인하세요."
  aiorg_pane_alive "$pane" || die "'$who' 의 pane 이 없습니다. ./aiorg up 으로 다시 세우세요."
  local title state badge
  title="$(aiorg_member_field "$who" title)"
  state="$(aiorg_member_state "$pane")"
  case "$state" in
    idle) badge="대기" ;;  busy) badge="작업중" ;;  starting) badge="부팅중" ;;
    prompt) badge="응답대기" ;;  login) badge="로그인필요" ;;  *) badge="미가동" ;;
  esac
  info "=== $who ($title) — $badge ==="
  tmux capture-pane -p -t "$pane" | grep -v '^[[:space:]]*$' | tail -n "$lines"
}


# 특정 멤버의 화면에 붙는다. 응답대기(대화상자) 처리에 쓴다.
cmd_attach() {
  local who="${1:-}"
  if [[ -z $who ]]; then
    info "붙을 수 있는 세션:"
    local dept
    while IFS=$'\t' read -r dept _; do
      [[ -n $dept ]] || continue
      info "  tmux attach -t $(aiorg_session_name "$dept")"
    done < <(st sessions)
    info ""
    info "특정 멤버에게 바로 붙으려면: ./aiorg attach <멤버id>"
    return 0
  fi
  local pane sess
  pane="$(aiorg_pane_of "$who")"
  sess="$(aiorg_session_of "$who")"
  [[ -n $pane ]] || die "'$who' 의 자리를 찾을 수 없습니다. ./aiorg up 을 실행했는지 확인하세요."
  aiorg_pane_alive "$pane" || die "'$who' 의 pane 이 이미 없습니다. ./aiorg up 으로 다시 세우세요."

  if [[ -n ${TMUX:-} ]]; then
    # 이미 tmux 안이면 중첩 attach 는 거부된다. 해당 창으로 전환만 한다.
    tmux switch-client -t "$pane" 2>/dev/null && return 0
    die "이미 tmux 안입니다. 다른 세션이라면: tmux switch-client -t $sess"
  fi
  tmux select-window -t "$pane" 2>/dev/null || true
  exec tmux attach -t "$sess"
}

# 상태 감지가 어긋날 때 어떤 표지가 걸렸는지 본다.
# Claude Code UI 문구가 바뀌면 lib/tmuxlib.sh 상단의 AIORG_PAT_* 를 고친다.
cmd_explain() {
  local who="${1:-}" pane
  [[ -n $who ]] || die "사용법: ./aiorg explain <멤버id>"
  pane="$(aiorg_pane_of "$who")"
  [[ -n $pane ]] || die "'$who' 의 자리를 찾을 수 없습니다."
  info "멤버 $who  (pane $pane)"
  aiorg_explain_state "$pane"
  info ""
  info "화면 마지막 8줄:"
  tmux capture-pane -p -t "$pane" -S -8 2>/dev/null | sed 's/^/  | /'
}

cmd_doctor() {
  local ok=1
  printf '환경 점검\n'
  printf '  AIORG_HOME : %s\n' "$AIORG_HOME"
  printf '  나          : %s\n' "$(aiorg_whoami || echo '(미확인 — 조직 세션 밖)')"
  for c in tmux git; do
    if command -v "$c" >/dev/null; then
      printf '  %-11s: %s\n' "$c" "$(command -v "$c")"
    else
      printf '  %-11s: 없음  <-- 필요\n' "$c"; ok=0
    fi
  done
  if "$AIORG_PY" -c 'import sys; sys.exit(0)' 2>/dev/null; then
    printf '  %-11s: %s\n' "python3" "$("$AIORG_PY" -V 2>&1)"
  else
    printf '  %-11s: 없음  <-- 필요\n' "python3"; ok=0
  fi
  if "$AIORG_PY" -c 'import yaml' 2>/dev/null; then
    printf '  %-11s: 설치됨\n' "PyYAML"
  else
    printf '  %-11s: 없음  <-- pip install pyyaml\n' "PyYAML"; ok=0
  fi
  if command -v claude >/dev/null; then
    printf '  %-11s: %s\n' "claude" "$(claude --version 2>&1 | head -1)"
  else
    printf '  %-11s: 없음  <-- 이 셸에서 claude 를 띄울 수 없습니다\n' "claude"; ok=0
  fi
  # 스킬은 필수가 아니다. 안 걸려 있으면 알려만 준다.
  local sdir="$AIORG_HOME/.claude/skills" total=0 linked=0 n
  if [[ -d $sdir ]]; then
    for n in "$sdir"/*/; do
      [[ -f "${n}SKILL.md" ]] || continue
      total=$((total + 1))
      [[ -L "$HOME/.claude/skills/$(basename "$n")" ]] && linked=$((linked + 1))
    done
  fi
  if ((total)); then
    if ((linked == total)); then
      printf '  스킬       : %d개 모두 연결됨\n' "$total"
    else
      printf '  스킬       : %d개 중 %d개 연결  <-- ./aiorg skills --link 로 어디서든 보이게 하세요\n' "$total" "$linked"
    fi
  fi
  printf '\n'
  ((ok)) && printf '이상 없습니다.\n' || printf '위의 누락 항목을 먼저 해결하세요.\n'
  ((ok)) || exit 1
}

