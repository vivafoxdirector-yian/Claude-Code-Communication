# ---------------------------------------------------------------- 디스패치

main() {
  local sub="${1:-help}"; shift || true
  case "$sub" in
    up)       cmd_up "$@" ;;
    launch)   cmd_launch "$@" ;;
    brief)    cmd_brief "$@" ;;
    down)     cmd_down "$@" ;;
    status)   cmd_status "$@" ;;
    org)      cmd_org "$@" ;;
    attach)   cmd_attach "$@" ;;
    layout)   cmd_layout "$@" ;;
    peek)     cmd_peek "$@" ;;
    explain)  cmd_explain "$@" ;;
    send)     cmd_send "$@" ;;
    reply)    cmd_reply "$@" ;;
    assign)   cmd_assign "$@" ;;
    report)   cmd_report "$@" ;;
    inbox)    cmd_inbox "$@" ;;
    task)     cmd_task "$@" ;;
    notify)   cmd_notify "$@" ;;
    log)      st log "$@" ;;
    members)  st members "$@" ;;
    areas)    st areas "$@" ;;
    artifacts) st artifacts "$@" ;;
    progress) st progress "$@" ;;
    clean)    cmd_clean "$@" ;;
    scaffold) cmd_scaffold "$@" ;;
    skills)   cmd_skills "$@" ;;
    templates) st templates "$@" ;;
    new)      st new "$@" ;;
    whoami)   aiorg_whoami ;;
    doctor)   cmd_doctor "$@" ;;
    help|-h|--help) cmd_help ;;
    *) die "알 수 없는 명령 '$sub' — ./aiorg help 를 보세요." ;;
  esac
}

main "$@"
